{
  "hosting": {
    "public": ".",
    "predeploy": "node scripts/generate-static-pages.js",
    "postdeploy": "node scripts/notify-subscribers.js",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.bat",
      "*.cmd",
      "*.ps1",
      "run_login.js",
      "scripts/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
