# ==============================================================================
# Keeping Up With The Singularity - Newsletter Environment Configuration
# ==============================================================================

# Option 1: Resend API (Recommended - Free 3,000 emails/month)
# Sign up at: https://resend.com
RESEND_API_KEY=re_123456789
EMAIL_FROM="Keeping up with the singularity <newsletter@keeping-up-singularity.web.app>"

# Option 2: Brevo API (Free 300 emails/day)
# Sign up at: https://brevo.com
BREVO_API_KEY=xkeysib-123456789

# Option 3: Standard SMTP / Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Base Website URL for article links
BASE_URL=https://keeping-up-singularity.web.app
